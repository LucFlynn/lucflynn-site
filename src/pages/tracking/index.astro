---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPages = await getCollection('pages', ({ data }) => data.category === 'tracking');
const hubs = allPages.filter(p => p.data.page_type === 'hub').sort((a, b) => a.data.title.localeCompare(b.data.title));
const spokes = allPages.filter(p => p.data.page_type !== 'hub').sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<BaseLayout
  title="Tracking Guides — Conversion Tracking Setup Library"
  description="Complete library of conversion tracking guides. Google Ads, Meta Ads, GA4, LinkedIn — form-specific setups, server-side GTM, Enhanced Conversions, and more."
  canonicalUrl="https://lucflynn.com/tracking"
  ogTitle="Tracking Guides — Conversion Tracking Setup Library"
  ogDescription="Step-by-step tracking setup guides for every form tool and ad platform combination."
  ogUrl="https://lucflynn.com/tracking"
  showFooter={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Tracking Guides",
      "description": "Complete library of conversion tracking guides",
      "author": {"@type": "Person", "name": "Luc Flynn"},
    })} />
  </Fragment>

  {/* nav handled by shared <Nav /> */}

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-10 prose-dark">
    <div class="text-center mb-12">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white">Tracking Guides</h1>
      <p class="mt-4 text-xl text-gray-400">Step-by-step conversion tracking setup for every form tool and ad platform.</p>
      <p class="mt-2 text-gray-500">Pick your combo. Follow the guide. Stop losing conversions.</p>
    </div>

    {hubs.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-white mb-6">Pillar Guides</h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {hubs.map((page) => (
            <a href={`/tracking/${page.data.slug}`} class="card-dark rounded-xl border-2 p-6 sop-card block">
              <div class="mb-3">
                <span class="category-badge">Hub</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">{page.data.title.replace(/ — .*$/, '')}</h3>
              <p class="text-gray-300 text-sm line-clamp-2">{page.data.description}</p>
              <div class="mt-4 text-purple-400 text-sm font-semibold">View Guide &rarr;</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">All Tracking Guides</h2>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {spokes.map((page) => (
          <a href={`/tracking/${page.data.slug}`} class="card-dark rounded-xl border-2 p-5 sop-card block">
            <h3 class="text-lg font-bold text-white mb-2">{page.data.title.replace(/ — .*$/, '').replace(/\(2026 Guide\)/, '').trim()}</h3>
            <p class="text-gray-400 text-sm line-clamp-2">{page.data.description}</p>
            <div class="mt-3 text-purple-400 text-sm font-semibold">Read Guide &rarr;</div>
          </a>
        ))}
      </div>
    </section>

    <footer class="mt-16 pt-8 border-t border-slate-700 text-center">
      <p class="text-gray-400">Need help setting up tracking? <a href="/contact" class="text-purple-400 hover:text-purple-300 font-semibold">Get a free tracking audit</a></p>
    </footer>
  </main>
</BaseLayout>
