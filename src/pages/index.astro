---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Ad System Management | Luc Flynn"
  description="Make sense of your paid advertising. Luc Flynn looks across your ads, tracking, landing pages, offer, and lead flow to find the weak point and lead the right fix."
>
  <!-- Hero Section -->
  <section class="hero system-hero">
    <div class="system-hero-grid">
      <div class="system-hero-copy">
        <div class="value-badge">AD SYSTEM MANAGEMENT</div>
        <h1 class="hero-headline">How Many People Have You Hired to Fix Your Ads?</h1>
        <p class="hero-subtext hero-story">
          A media buyer. A web designer. A tracking expert. Maybe another consultant.
          Everyone fixes one piece. Nobody makes sense of the whole system.
        </p>
        <p class="system-promise">
          I look across your ads, tracking, landing pages, offer, and lead flow. Then I make the numbers clear, find the weak point, and lead the fix.
        </p>
        <p class="system-summary">One clear plan. No more experts blaming each other.</p>

        <div class="trust-indicators system-trust">
          <div class="indicator">
            <span class="indicator-number">150+</span>
            <span class="indicator-label">Clients Served</span>
          </div>
          <div class="indicator">
            <span class="indicator-number">$11M+</span>
            <span class="indicator-label">Ad Spend Managed</span>
          </div>
          <div class="indicator">
            <span class="indicator-number">8+</span>
            <span class="indicator-label">Years Experience</span>
          </div>
        </div>

        <a href="#quick-wins" class="resource-jump">Just looking? Browse the free tools &darr;</a>
      </div>

      <aside id="tell-me" class="hero-contact-card" aria-labelledby="hero-form-title">
        <span class="form-kicker">NO SALES CALL REQUIRED</span>
        <h2 id="hero-form-title">Tell Me What's Going On</h2>
        <p>Send me your site and a short note. I'll reply with the clearest next step I see.</p>

        <form action="https://formspree.io/f/mblqrqoq" method="POST" class="hero-contact-form">
          <input type="hidden" name="_subject" value="Homepage Ad System Question" />
          <input type="hidden" name="source" value="homepage-hero" />
          <input type="hidden" name="utm_source" id="hero_utm_source" value="" />
          <input type="hidden" name="utm_medium" id="hero_utm_medium" value="" />
          <input type="hidden" name="utm_campaign" id="hero_utm_campaign" value="" />
          <input type="hidden" name="utm_content" id="hero_utm_content" value="" />
          <input type="hidden" name="fbclid" id="hero_fbclid" value="" />
          <input type="hidden" name="gclid" id="hero_gclid" value="" />

          <label for="hero-email">Work email</label>
          <input type="email" id="hero-email" name="email" required placeholder="you@company.com" autocomplete="email" />

          <label for="hero-website">Website</label>
          <input type="text" id="hero-website" name="website" required placeholder="yourcompany.com" autocomplete="url" />

          <label for="hero-problem">What are you trying to fix?</label>
          <textarea id="hero-problem" name="problem" required rows="4" placeholder="The ads look fine, but the leads aren't turning into sales..."></textarea>

          <button type="submit">Send Me the Problem &rarr;</button>
        </form>
        <small>No pressure and no automated pitch. I'll answer by email.</small>
      </aside>
    </div>
  </section>

  <!-- Work With Me Section -->
  <section id="work" class="work">
    <div class="container">
      <div class="section-header">
        <h2>Three Ways to Work With Me</h2>
        <p>Start with the foundation. Add the level of ownership your business needs.</p>
      </div>

      <div class="offer-grid">
        <div class="offer-card">
          <span class="offer-level">1 &middot; START</span>
          <h3>Ad System Setup</h3>
          <div class="price">Starting at $1,600</div>
          <ul>
            <li>Review the ads, tracking, landing pages, offer, and lead flow</li>
            <li>Find the weak point before spending more money</li>
            <li>Fix the tracking and campaign foundation</li>
            <li>Leave with one clear plan for what happens next</li>
          </ul>
          <a href="#tell-me" class="btn-primary">Tell Me What's Going On &rarr;</a>
        </div>

        <div class="offer-card offer-card-featured">
          <span class="offer-level">2 &middot; MANAGE</span>
          <h3>Managed Ad System</h3>
          <div class="price">Starting at $400/month</div>
          <ul>
            <li>Ongoing Google or Meta campaign management</li>
            <li>Monitoring, support, and one clear monthly report</li>
            <li>We watch for the weak point to move</li>
            <li>Add more reporting or strategy time only when you need it</li>
            <li>You keep your accounts and your data</li>
          </ul>
          <a href="#tell-me" class="btn-primary">Tell Me What's Going On &rarr;</a>
        </div>

        <div class="offer-card">
          <span class="offer-level">3 &middot; LEAD</span>
          <h3>Director of Advertising</h3>
          <div class="price">Starting at $5,000/month</div>
          <ul>
            <li>I lead the complete paid-advertising system</li>
            <li>Set priorities and decide what gets fixed next</li>
            <li>Direct the specialists working on each piece</li>
            <li>Turn the numbers into clear business decisions</li>
            <li>Lead each fix from strategy through execution</li>
          </ul>
          <a href="#tell-me" class="btn-primary">Talk to Me About the System &rarr;</a>
        </div>
      </div>

      <p class="constraint-note">
        Landing pages, tracking builds, positioning sprints, and other constraint fixes are scoped separately when the system shows they are needed.
      </p>
    </div>
  </section>

  <!-- Quick Win Section -->
  <section id="quick-wins" class="quick-wins">
    <div class="container">
      <div class="section-header">
        <h2>Free Diagnostic Tools</h2>
        <p>Find out what's broken before you spend another dollar</p>
      </div>

      <div class="resource-grid">
        <a href="/tools/ad-account-health-checker" class="resource-card-link">
          <div class="resource-card featured">
            <div class="card-badge">MOST POPULAR</div>
            <h3>Ad Account Health Check</h3>
            <p>Enter your last 30 days of data and get an instant diagnosis. Takes 2 minutes, tells you exactly what's leaking money.</p>
            <ul class="resource-benefits">
              <li>&#10003; Instant performance diagnosis</li>
              <li>&#10003; 3 prioritized improvements</li>
              <li>&#10003; Benchmarks vs. your industry</li>
            </ul>
            <span class="resource-link">Run Free Health Check &rarr;</span>
          </div>
        </a>

        <a href="/templates/facebook-lead-spam-checklist" class="resource-card-link">
          <div class="resource-card">
            <h3>Stop Facebook Lead Spam</h3>
            <p>61% of advertisers cite junk leads as their #1 problem. This checklist cuts spam by 40-60% in 48 hours.</p>
            <ul class="resource-benefits">
              <li>&#10003; Lead qualification question library</li>
              <li>&#10003; Facebook form setup guide</li>
              <li>&#10003; Spam reduction tactics</li>
            </ul>
            <span class="resource-link">Get Free Checklist &rarr;</span>
          </div>
        </a>

        <a href="/templates/weekly-optimization-checklists" class="resource-card-link">
          <div class="resource-card">
            <h3>Weekly Optimization Checklists</h3>
            <p>20-minute Google & Meta optimization routines. Never miss critical checks that leak money.</p>
            <ul class="resource-benefits">
              <li>&#10003; Google Ads 20-min checklist</li>
              <li>&#10003; Facebook Ads 20-min checklist</li>
              <li>&#10003; Prioritized by impact</li>
            </ul>
            <span class="resource-link">Get Checklists &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Level Up Section -->
  <section id="all-resources" class="all-resources level-up">
    <div class="container">
      <div class="section-header">
        <h2>More Free Resources</h2>
        <p>SOPs, calculators, and frameworks — no email required</p>
      </div>

      <details class="expandable-section" open>
        <summary class="expand-toggle">
          <span class="toggle-text">Show Resources</span>
          <span class="toggle-icon">&#9660;</span>
        </summary>

        <div class="resource-categories">
          <!-- Templates & Calculators -->
          <div class="category-block">
            <div class="category-header">
              <h3>&#128202; Calculators & Tools</h3>
              <span class="item-count">3 Tools</span>
            </div>
            <div class="category-items">
              <a href="/tools/ad-account-health-checker">Ad Account Health Check</a>
              <a href="/templates/lead-score">Lead Quality Score Calculator</a>
              <a href="/templates/calculator">CAC Calculator</a>
            </div>
          </div>

          <!-- Advanced SOPs -->
          <div class="category-block">
            <div class="category-header">
              <h3>&#128203; Deep-Dive SOPs</h3>
              <span class="item-count">6 Guides</span>
            </div>
            <div class="category-items">
              <a href="/sop/keyword-optimization">Keyword Optimization</a>
              <a href="/sop/campaign-optimization">Campaign Optimization</a>
              <a href="/sop/scaling">Scaling Framework</a>
              <a href="/sop/landing-page">Landing Page Optimization</a>
              <a href="/sop/conversion-tracking">Conversion Tracking Setup</a>
              <a href="/sop/lead-scoring">Lead Scoring</a>
              <a href="/sop" class="see-all">See all SOPs &rarr;</a>
            </div>
          </div>
          <!-- Tracking & Integration Guides -->
          <div class="category-block">
            <div class="category-header">
              <h3>&#128640; Tracking & Integration Guides</h3>
              <span class="item-count">160+ Guides</span>
            </div>
            <div class="category-items">
              <a href="/tracking">Conversion Tracking Guides</a>
              <a href="/integrations">Form-to-CRM Integrations</a>
              <a href="/attribution">Attribution Tool Setup</a>
              <a href="/services">Solutions Library</a>
            </div>
          </div>
        </div>
      </details>
    </div>
  </section>

  <!-- About Section -->
  <section class="about">
    <div class="container">
      <div class="about-content">
        <div class="about-text">
          <h2>Why I Give Away My Playbooks</h2>
          <p class="lead">Most businesses running ads are flying blind. The account is leaking, the tracking is lying, and nobody is actually looking at it.</p>
          <p>I've spent 8+ years and $11M+ in ad spend learning exactly how to fix this. Every SOP, template, and tool on this site is something I actually use with clients.</p>
          <p>I give it away because the bottleneck is never knowledge — it's execution. The people who can execute become great partners. The ones who can't become great clients.</p>
          <div class="about-stats">
            <div class="stat">
              <strong>150+</strong> clients served
            </div>
            <div class="stat">
              <strong>$11M+</strong> ad spend managed
            </div>
            <div class="stat">
              <strong>7+</strong> agency partners
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta">
    <div class="container" style="text-align: center; padding: 4rem 2rem;">
      <h2 style="font-size: 2rem; color: #fff; margin-bottom: 1rem;">Not Sure What You Need?</h2>
      <p style="font-size: 1.15rem; color: #B0B8E0; margin-bottom: 2rem; max-width: 600px; margin-left: auto; margin-right: auto;">
        Start with a free audit. I'll open your ad account, tell you where the money is actually going, and give you a plan — whether you hire me or not.
      </p>
      <a href="/contact" class="btn-primary" style="font-size: 1.1rem; padding: 1rem 2.5rem;">
        Request Free Audit &rarr;
      </a>
    </div>
  </section>

  <script>
    // Handle expandable section
    const summary = document.querySelector('.expandable-section summary');
    if (summary) {
      summary.addEventListener('click', function() {
        const icon = this.querySelector('.toggle-icon');
        const text = this.querySelector('.toggle-text');
        setTimeout(() => {
          if (this.parentElement.open) {
            icon.textContent = '\u25BC';
            text.textContent = 'Show Resources';
          } else {
            icon.textContent = '\u25B2';
            text.textContent = 'Hide Resources';
          }
        }, 10);
      });
    }

    // Keep the ad context attached to low-pressure homepage enquiries.
    const params = new URLSearchParams(window.location.search);
    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'fbclid', 'gclid'].forEach((field) => {
      const value = params.get(field);
      const input = document.getElementById(`hero_${field}`);
      if (value && input instanceof HTMLInputElement) input.value = value;
    });
  </script>
</BaseLayout>

<style>
  .system-hero {
    padding: 4.5rem 0;
  }

  .system-hero-grid {
    width: min(1180px, calc(100% - 3rem));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(340px, 0.85fr);
    gap: 4rem;
    align-items: center;
  }

  .system-hero-copy {
    text-align: left;
  }

  .system-hero-copy .value-badge {
    margin-bottom: 1.5rem;
  }

  .system-hero-copy .hero-headline {
    font-size: clamp(2.8rem, 5.6vw, 5rem);
    max-width: 780px;
    letter-spacing: -0.045em;
    margin-bottom: 1.5rem;
  }

  .hero-story {
    max-width: 700px;
    margin-bottom: 1rem;
    color: #cbd5e1;
  }

  .system-promise {
    max-width: 700px;
    color: #f8fafc;
    font-size: 1.15rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .system-summary {
    color: #60a5fa;
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }

  .system-trust {
    justify-content: flex-start;
    gap: 2.25rem;
    margin-bottom: 1.75rem;
  }

  .system-trust .indicator {
    align-items: flex-start;
  }

  .resource-jump {
    color: #a5b4fc;
    font-weight: 600;
    border-bottom: 1px solid rgba(165, 180, 252, 0.45);
  }

  .hero-contact-card {
    background: linear-gradient(150deg, rgba(30, 41, 59, 0.98), rgba(15, 23, 42, 0.98));
    border: 1px solid rgba(99, 102, 241, 0.55);
    border-radius: 18px;
    padding: 2rem;
    box-shadow: 0 28px 70px rgba(2, 6, 23, 0.38);
  }

  .form-kicker {
    display: block;
    color: #34d399;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    margin-bottom: 0.65rem;
  }

  .hero-contact-card h2 {
    font-size: 1.85rem;
    margin-bottom: 0.65rem;
  }

  .hero-contact-card > p {
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .hero-contact-form {
    display: grid;
    gap: 0.65rem;
  }

  .hero-contact-form label {
    color: #cbd5e1;
    font-size: 0.82rem;
    font-weight: 700;
    margin-top: 0.35rem;
  }

  .hero-contact-form input,
  .hero-contact-form textarea {
    width: 100%;
    border: 1px solid #334155;
    border-radius: 8px;
    background: #0b1220;
    color: #f8fafc;
    font: inherit;
    padding: 0.82rem 0.9rem;
  }

  .hero-contact-form input:focus,
  .hero-contact-form textarea:focus {
    outline: 2px solid rgba(99, 102, 241, 0.45);
    border-color: #818cf8;
  }

  .hero-contact-form textarea {
    resize: vertical;
    min-height: 106px;
  }

  .hero-contact-form button {
    margin-top: 0.65rem;
    border: 0;
    border-radius: 8px;
    padding: 0.95rem 1rem;
    background: #2563eb;
    color: #fff;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .hero-contact-form button:hover {
    background: #1d4ed8;
  }

  .hero-contact-card small {
    display: block;
    color: #64748b;
    text-align: center;
    line-height: 1.5;
    margin-top: 0.85rem;
  }

  .offer-level {
    display: inline-block;
    color: #34d399;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    margin-bottom: 0.75rem;
  }

  .offer-card-featured {
    border-color: rgba(99, 102, 241, 0.85);
    box-shadow: 0 18px 45px rgba(2, 6, 23, 0.24);
  }

  .offer-card .price {
    font-size: 1.45rem;
  }

  .offer-card .btn-primary {
    width: 100%;
    text-align: center;
    padding: 0.85rem 1rem;
  }

  .constraint-note {
    max-width: 850px;
    margin: 2rem auto 0;
    color: #94a3b8;
    text-align: center;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .system-hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      width: min(720px, calc(100% - 2.5rem));
    }

    .system-hero-copy,
    .system-trust .indicator {
      text-align: center;
      align-items: center;
    }

    .system-trust {
      justify-content: center;
    }
  }

  @media (max-width: 560px) {
    .system-hero {
      padding: 3rem 0;
    }

    .system-hero-copy .hero-headline {
      font-size: 2.4rem;
    }

    .system-trust {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
    }

    .system-trust .indicator-number {
      font-size: 1.2rem;
    }

    .system-trust .indicator-label {
      font-size: 0.68rem;
    }

    .hero-contact-card {
      padding: 1.4rem;
    }
  }
</style>
