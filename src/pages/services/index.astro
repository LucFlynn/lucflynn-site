---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPages = await getCollection('pages', ({ data }) => data.category === 'services');
const hubs = allPages.filter(p => p.data.page_type === 'hub');
const technical = allPages.filter(p => p.data.page_type === 'service_technical').sort((a, b) => a.data.title.localeCompare(b.data.title));
const verticals = allPages.filter(p => p.data.page_type === 'service_vertical').sort((a, b) => a.data.title.localeCompare(b.data.title));
const spokes = allPages.filter(p => p.data.page_type === 'spoke').sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<BaseLayout
  title="Services — Tracking, Analytics & Google Ads Management"
  description="Professional tracking infrastructure, analytics setup, attribution services, and industry-specific Google Ads management by Luc Flynn."
  canonicalUrl="https://lucflynn.com/services"
  ogTitle="Services — Tracking, Analytics & Google Ads Management"
  ogDescription="Done-for-you tracking setup, attribution, and Google Ads management."
  ogUrl="https://lucflynn.com/services"
  showFooter={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Services",
      "description": "Professional tracking and analytics services",
      "author": {"@type": "Person", "name": "Luc Flynn"},
    })} />
  </Fragment>

  {/* nav handled by shared <Nav /> */}

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-10 prose-dark">
    <div class="text-center mb-12">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white">Services</h1>
      <p class="mt-4 text-xl text-gray-400">Done-for-you tracking infrastructure, analytics, and Google Ads management.</p>
      <p class="mt-2 text-gray-500">If you'd rather not DIY it, I've done this 200+ times.</p>
    </div>

    {technical.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-white mb-6">Technical Services</h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {technical.map((page) => (
            <a href={`/services/${page.data.slug}`} class="card-dark rounded-xl border-2 p-6 sop-card block">
              <div class="mb-3">
                <span class="category-badge">Service</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">{page.data.title.replace(/ — .*$/, '').replace(/ \| .*$/, '')}</h3>
              <p class="text-gray-300 text-sm line-clamp-2">{page.data.description}</p>
              <div class="mt-4 text-purple-400 text-sm font-semibold">Learn More &rarr;</div>
            </a>
          ))}
        </div>
      </section>
    )}

    {verticals.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-white mb-6">Industry-Specific Google Ads Management</h2>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {verticals.map((page) => (
            <a href={`/services/${page.data.slug}`} class="card-dark rounded-xl border-2 p-5 sop-card block">
              <h3 class="text-lg font-bold text-white mb-2">{page.data.title.replace(/ — .*$/, '').replace(/ \| .*$/, '')}</h3>
              <p class="text-gray-400 text-sm line-clamp-2">{page.data.description}</p>
              <div class="mt-3 text-purple-400 text-sm font-semibold">Learn More &rarr;</div>
            </a>
          ))}
        </div>
      </section>
    )}

    {spokes.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-white mb-6">All Service Pages</h2>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {spokes.map((page) => (
            <a href={`/services/${page.data.slug}`} class="card-dark rounded-xl border-2 p-5 sop-card block">
              <h3 class="text-lg font-bold text-white mb-2">{page.data.title}</h3>
              <p class="text-gray-400 text-sm line-clamp-2">{page.data.description}</p>
              <div class="mt-3 text-purple-400 text-sm font-semibold">Learn More &rarr;</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <footer class="mt-16 pt-8 border-t border-slate-700 text-center">
      <p class="text-gray-400">Ready to get started? <a href="/contact" class="text-purple-400 hover:text-purple-300 font-semibold">Get a free tracking audit</a></p>
    </footer>
  </main>
</BaseLayout>
